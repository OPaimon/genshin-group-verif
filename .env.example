API_ID=
API_HASH=
BOT_TOKEN=
# Optional Sentry DSN for error monitoring. Leave empty to disable (local dev).
SENTRY_DSN=
# Environment tag shown in Sentry (production / staging / development)
SENTRY_ENVIRONMENT=production
# Numeric peer id of the chat/channel that receives verification logs
LOG_PEER=
# Comma-separated numeric user ids allowed to run /reload (empty = disabled)
ADMIN_IDS=
# "join more groups" ad link in verification messages
# (omit for the default link, set empty to disable the ad block)
# AD_LIST_URL=
