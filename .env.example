API_ID=
API_HASH=
BOT_TOKEN=
# Verification-state backend: memory (default, volatile) | sqlite (persistent).
# Docker Compose and bare-process runs both keep the memory default unless overridden.
# STATE_BACKEND=sqlite
# SQLite file path used when STATE_BACKEND=sqlite.
STATE_SQLITE_PATH=bot-data/state.db
# Optional Sentry DSN for error monitoring. Leave empty to disable (local dev).
SENTRY_DSN=
# Optional environment tag. Defaults to production in the built bundle and
# development elsewhere; uncomment to override (for example, staging).
# SENTRY_ENVIRONMENT=staging
# Minimum log level forwarded to Sentry Logs: debug | info | warn | error
SENTRY_LOG_LEVEL=info
# Numeric peer id of the chat/channel that receives verification logs
LOG_PEER=
# Comma-separated numeric user ids allowed to run /reload (empty = disabled)
ADMIN_IDS=
# "join more groups" ad link in verification messages
# (omit for the default link, set empty to disable the ad block)
# AD_LIST_URL=
