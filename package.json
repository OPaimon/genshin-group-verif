{
    "name": "genshin-group-verif",
    "type": "module",
    "version": "0.0.1",
    "packageManager": "pnpm@10.17.1",
    "license": "MIT",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "lint:ai": "alint src",
        "lint:ai:dirty": "alint --dirty",
        "dev": "dotenv tsx watch ./src/main.ts",
        "dev:debug": "dotenv -- node --inspect=9229 --enable-source-maps --import tsx ./src/main.ts",
        "start": "tsx --env-file=.env ./src/main.ts",
        "build": "node build.mjs",
        "start:prod": "node --enable-source-maps dist/main.mjs",
        "res:build": "rescript",
        "res:clean": "rescript clean",
        "res:dev": "rescript watch",
        "test": "rescript && node --test src/FlowTest.res.mjs && node --import tsx --import ./src/interpreter/testEnv.ts --test build.test.mjs src/flowParallel.test.ts src/sentry.test.ts src/interpreter/bindingConformance.test.ts src/interpreter/interaction.test.ts src/interpreter/messages.test.ts src/interpreter/task.test.ts src/interpreter/ttlMap.test.ts src/interpreter/state/memoryStore.test.ts src/interpreter/state/sqliteStore.test.ts"
    },
    "dependencies": {
        "@mtcute/dispatcher": "^0.31.0",
        "@mtcute/html-parser": "^0.31.0",
        "@mtcute/node": "^0.31.0",
        "@mtcute/wasm": "^0.31.0",
        "@rescript/runtime": "^12.1.0",
        "@sentry/node": "^10.70.0",
        "better-sqlite3": "^12.10.0",
        "dotenv-cli": "^11.0.0",
        "rescript": "12.1.0",
        "tsx": "^4.21.0"
    },
    "devDependencies": {
        "@alint-js/cli": "0.6.0",
        "@antfu/eslint-config": "^7.4.3",
        "@rescript/language-server": "1.74.0",
        "@types/node": "^25.2.3",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.2",
        "typescript": "^5.9.3",
        "typescript-language-server": "5.1.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "esbuild"
        ]
    }
}
